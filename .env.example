# ========================================================
# THINK UNLIMITED - CLASS 10 MATHS E-BOOK CONFIGURATION
# ========================================================

# Server Port
PORT=3000

# Razorpay API Credentials (Test or Live)
# Get these from https://dashboard.razorpay.com/#/app/keys
# In Test mode: Starts with rzp_test_...
# In Live mode: Starts with rzp_live_...
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# Razorpay Webhook Secret (Set up in Razorpay Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Download Security Secret (Used for HMAC signed 48-hour download tokens)
DOWNLOAD_SECRET=think_unlimited_super_secure_secret_token_2026

# Admin Portal Password (Access at /admin)
ADMIN_PASSWORD=thinkunlimited2026

# Email Delivery (Optional: Nodemailer SMTP)
# If left blank, download links will be safely logged in the server console and orders database
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Think Unlimited <support@thinkunlimited.in>

# Analytics Placeholders
META_PIXEL_ID=
GA_MEASUREMENT_ID=

# Cashfree Payment Gateway Credentials
# Sandbox Dashboard: https://sandbox.cashfree.com/
# Production Dashboard: https://merchant.cashfree.com/
# Set CASHFREE_ENV to either "sandbox" or "production"
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=production
CASHFREE_API_VERSION=2023-08-01
